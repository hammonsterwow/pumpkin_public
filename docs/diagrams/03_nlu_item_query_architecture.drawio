        <mxCell id="output_intent" value="&lt;b&gt;Intent&lt;/b&gt; = ORDER&lt;br&gt;&lt;b&gt;Status&lt;/b&gt; = ORDERING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F7FAF6;strokeColor=#7B9A75;strokeWidth=1.2;fontColor=#2D4D29;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1225" y="190" width="265" height="85" as="geometry"/></mxCell>
        <mxCell id="output_items" value="&lt;b&gt;Structured order items&lt;/b&gt;&lt;br&gt;&lt;br&gt;Item 1 : Americano / ICE / 2&lt;br&gt;Item 2 : Cafe Latte / HOT / 1&lt;br&gt;Item 3 : Inactive / None" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F7FAF6;strokeColor=#7B9A75;strokeWidth=1.3;fontColor=#2D4D29;fontSize=12;align=left;verticalAlign=middle;spacingLeft=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="585" width="280" height="115" as="geometry"/></mxCell>

        <mxCell id="note" value="&lt;b&gt;Key idea.&lt;/b&gt; Item queries bind menu, temperature, and quantity predictions to the same order item, preserving option-to-menu alignment in multi-item utterances." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#B8B8B8;strokeWidth=1;fontColor=#444444;fontSize=11;align=left;verticalAlign=middle;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="325" y="735" width="895" height="65" as="geometry"/></mxCell>
        <mxCell id="caption" value="Figure. Inference architecture of the Structure-B NLU model implemented in pumpkin/nlu/model.py" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#777777;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="815" width="800" height="25" as="geometry"/></mxCell>

