        <mxCell id="dec_group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BFBFBF;strokeWidth=1;dashed=1;dashPattern=6 4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="665" y="150" width="480" height="535" as="geometry"/></mxCell>
