        <mxCell id="utterance" value="&lt;b&gt;User utterance&lt;/b&gt;&lt;br&gt;&lt;br&gt;“아이스 아메리카노 두 잔하고&lt;br&gt;따뜻한 카페라떼 한 잔 주세요”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.3;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="205" height="120" as="geometry"/></mxCell>
        <mxCell id="tokenizer" value="&lt;b&gt;Tokenizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;input_ids, attention_mask&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAFAFA;strokeColor=#6B6B6B;strokeWidth=1.2;fontColor=#222222;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="77" y="390" width="170" height="75" as="geometry"/></mxCell>
        <mxCell id="input_tokens" value="[CLS] 아이스 아메리카노 ... [SEP]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AFAFAF;strokeWidth=1;fontColor=#555555;fontSize=11;align=center;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="62" y="535" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="input_caption" value="Natural-language order input&lt;br&gt;single or multiple menu items" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#777777;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="605" width="205" height="45" as="geometry"/></mxCell>

        <mxCell id="encoder" value="&lt;b&gt;KoELECTRA-base-v3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Transformer Encoder&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555555&quot;&gt;Contextual representation of the entire utterance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F8FC;strokeColor=#5B7DAA;strokeWidth=1.5;fontColor=#17365D;fontSize=15;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="365" y="270" width="225" height="150" as="geometry"/></mxCell>
        <mxCell id="cls_repr" value="&lt;b&gt;h&lt;sub&gt;CLS&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;utterance-level representation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C93B2;strokeWidth=1.2;fontColor=#294E7A;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="500" width="120" height="85" as="geometry"/></mxCell>
        <mxCell id="token_memory" value="&lt;b&gt;H = {h&lt;sub&gt;1&lt;/sub&gt;...h&lt;sub&gt;T&lt;/sub&gt;}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;token memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#7C93B2;strokeWidth=1.2;fontColor=#294E7A;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="485" y="500" width="125" height="85" as="geometry"/></mxCell>

        <mxCell id="utter_group" value="Utterance-level tasks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FCFCFC;strokeColor=#A8A8A8;strokeWidth=1;dashed=1;fontColor=#555555;fontSize=11;fontStyle=2;align=center;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="690" y="175" width="430" height="135" as="geometry"/></mxCell>
        <mxCell id="intent_head" value="&lt;b&gt;Intent Head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;ORDER / MODIFY / CANCEL / ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#7A6C91;strokeWidth=1.2;fontColor=#3F3155;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="165" height="65" as="geometry"/></mxCell>
        <mxCell id="status_head" value="&lt;b&gt;Order Status Head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;dialogue/order status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#7A6C91;strokeWidth=1.2;fontColor=#3F3155;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="925" y="220" width="165" height="65" as="geometry"/></mxCell>

        <mxCell id="queries" value="&lt;b&gt;Learnable item queries&lt;/b&gt;&lt;br&gt;&lt;br&gt;q&lt;sub&gt;1&lt;/sub&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;q&lt;sub&gt;2&lt;/sub&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;q&lt;sub&gt;3&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;one query per potential order item&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FAF8FC;strokeColor=#8E77A8;strokeWidth=1.2;fontColor=#46315D;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="745" y="350" width="315" height="95" as="geometry"/></mxCell>
        <mxCell id="decoder" value="&lt;b&gt;Transformer Item Decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555555&quot;&gt;query self-attention + cross-attention over token memory H&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8F5FA;strokeColor=#80649C;strokeWidth=1.5;fontColor=#3F3155;fontSize=14;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="720" y="500" width="365" height="90" as="geometry"/></mxCell>
        <mxCell id="decoded" value="z&lt;sub&gt;1&lt;/sub&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;z&lt;sub&gt;2&lt;/sub&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;z&lt;sub&gt;3&lt;/sub&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#4E3E63;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="200" height="30" as="geometry"/></mxCell>

        <mxCell id="heads_group" value="Item-wise prediction heads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FCFCFC;strokeColor=#A8A8A8;strokeWidth=1;dashed=1;fontColor=#555555;fontSize=11;fontStyle=2;align=center;verticalAlign=top;spacingTop=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1195" y="335" width="325" height="220" as="geometry"/></mxCell>
