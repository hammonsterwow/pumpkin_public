        <mxCell id="title" value="KoELECTRA-based Multi-item NLU Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#111111;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="28" width="1000" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Utterance-level intent/status prediction + item-query based structured order extraction" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="66" width="960" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="stage1" value="(1) Input encoding" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="220" height="25" as="geometry"/></mxCell>
        <mxCell id="stage2" value="(2) Contextual encoder" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="335" y="120" width="280" height="25" as="geometry"/></mxCell>
        <mxCell id="stage3" value="(3) Item-query decoding" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="690" y="120" width="430" height="25" as="geometry"/></mxCell>
        <mxCell id="stage4" value="(4) Structured prediction" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1225" y="120" width="300" height="25" as="geometry"/></mxCell>

        <mxCell id="input_group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BFBFBF;strokeWidth=1;dashed=1;dashPattern=6 4;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="150" width="255" height="535" as="geometry"/></mxCell>
