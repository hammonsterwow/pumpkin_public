        <mxCell id="temp_head" value="Temperature" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#6E8C6A;strokeWidth=1.1;fontColor=#345431;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="470" width="125" height="50" as="geometry"/></mxCell>
