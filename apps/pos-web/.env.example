# Cloud Relay public base URL. Do not include a trailing slash.
POS_RELAY_BASE_URL=https://YOUR-CLOUD-RUN-URL

# Server-only Relay credential. Never expose this through VITE_* variables.
JETSON_RELAY_TOKEN=change-me

# Keep passwordless POS server local by default.
# Change to 0.0.0.0 only on a trusted store network or behind an authenticated proxy.
POS_BIND_HOST=127.0.0.1

# Optional
POS_PORT=4174

# DEMO MODE is persisted until the operator explicitly turns it OFF.
# Default: apps/pos-web/.runtime/demo-mode.json
# POS_DEMO_STATE_FILE=/absolute/path/to/demo-mode.json
