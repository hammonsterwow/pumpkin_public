FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    PUMPKIN_FACE_MODEL_ROOT=/opt/insightface \
    PUMPKIN_FACE_PROVIDERS=CPUExecutionProvider

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt /app/api/requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel Cython "numpy<2" \
    && pip install --no-cache-dir -r /app/api/requirements.txt

COPY api /app/api

# 모델을 이미지 빌드 시 받아 첫 요청의 지연과 런타임 다운로드 실패를 피한다.
RUN python -c "from insightface.app import FaceAnalysis; app=FaceAnalysis(name='buffalo_l', root='/opt/insightface', providers=['CPUExecutionProvider']); app.prepare(ctx_id=-1, det_size=(640, 640))"

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
